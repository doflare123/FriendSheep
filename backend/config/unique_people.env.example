# Все экземпляры монолита используют одинаковые лимиты.
# Изменение общего лимита выполняется согласованно для всего deployment.
STATISTICS_UNIQUE_CLAIM_BATCH=1
STATISTICS_UNIQUE_CONCURRENCY=1
STATISTICS_UNIQUE_QUERY_TIMEOUT=20s
STATISTICS_UNIQUE_LEASE_DURATION=2m
STATISTICS_UNIQUE_RETRY_BASE=1m
STATISTICS_UNIQUE_RETRY_MAX=1h
