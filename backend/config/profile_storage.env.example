# Подключение нового хранилища аватаров; бакет создаётся заранее.
S3_ENABLED=false
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=profile-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный домен конкретного бакета или HTTPS CDN с корнем этого бакета.
S3_PUBLIC_BASE_URL=https://YOUR-BUCKET-UUID.selstorage.ru
S3_HTTP_TIMEOUT=15s
