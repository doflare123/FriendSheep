FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/server .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && addgroup -S friendship \
    && adduser -S friendship -G friendship \
    && mkdir -p /app/logs \
    && chown friendship:friendship /app/logs

WORKDIR /app
COPY --from=builder /out/server ./server
COPY --from=builder /app/db/data ./db/data
COPY --from=builder /app/migration ./migration

USER friendship

EXPOSE 8080

CMD ["./server"]
