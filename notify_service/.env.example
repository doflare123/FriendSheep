# Обязательно: база данных, принадлежащая исключительно notify_service.
NOTIFY_DATABASE_URL=postgres://notify_user:replace_me@localhost:5432/notify_service?sslmode=disable

# Обязательно: HTTP origin монолита и общий service-to-service secret.
NOTIFY_MONOLITH_BASE_URL=http://localhost:8080
NOTIFY_SERVICE_TOKEN=replace_with_a_long_random_secret

# Необязательные настройки процесса.
PORT=8080
NOTIFY_LOG_LEVEL=info
NOTIFY_HTTP_READ_TIMEOUT=5s
NOTIFY_HTTP_READ_HEADER_TIMEOUT=5s
NOTIFY_HTTP_WRITE_TIMEOUT=10s
NOTIFY_HTTP_IDLE_TIMEOUT=60s
NOTIFY_HTTP_SHUTDOWN_TIMEOUT=10s
NOTIFY_DATABASE_CONNECT_TIMEOUT=10s
NOTIFY_DATABASE_READY_TIMEOUT=2s
NOTIFY_MONOLITH_HTTP_TIMEOUT=5s
NOTIFY_SOURCE_POLL_INTERVAL=5s
NOTIFY_SOURCE_RETRY_MIN_BACKOFF=1s
NOTIFY_SOURCE_RETRY_MAX_BACKOFF=30s
NOTIFY_SOURCE_BATCH_LIMIT=100
NOTIFY_WORKER_SCAN_INTERVAL=1s
NOTIFY_WORKER_RETRY_MIN_BACKOFF=1s
NOTIFY_WORKER_RETRY_MAX_BACKOFF=5m
NOTIFY_JOB_LEASE_DURATION=30s

# Telegram, FCM, email, device registration, пользовательские JWT и URL базы
# данных монолита намеренно отсутствуют. Канонические reminder offsets
# (1440/360/60 минут) являются частью versioned intent, а не локальной
# конфигурацией одного lead time. NOTIFY_JOB_LEASE_DURATION должен быть больше
# NOTIFY_MONOLITH_HTTP_TIMEOUT.
